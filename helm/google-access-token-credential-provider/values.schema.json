{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "affinity": {
            "type": "object",
            "additionalProperties": false
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "enabled": {
            "type": "boolean"
        },
        "exchangeTimeout": {
            "type": "string",
            "pattern": "^[0-9]+(ms|s|m)$"
        },
        "fullnameOverride": {
            "type": "string"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts",
            "$comment": "Added automatically by 'helm schema' to allow this chart to be used as a Helm dependency, as this schema would otherwise not allow Helm's special 'global' values key."
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "digest": {
                    "type": "string",
                    "pattern": "^(sha256:[0-9a-f]{64})?$"
                },
                "name": {
                    "type": "string"
                },
                "pullPolicy": {
                    "type": "string",
                    "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                    ]
                },
                "registry": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "logLevel": {
            "type": "string",
            "enum": [
                "debug",
                "info",
                "warn",
                "error"
            ]
        },
        "name": {
            "type": "string"
        },
        "namespacePolicies": {
            "type": "array"
        },
        "networkPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cilium": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "dns": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "labels": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "properties": {
                                            "k8s-app": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "namespace": {
                                        "type": "string"
                                    }
                                }
                            }
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "tokenHosts": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1
                        }
                    }
                },
                "enabled": {
                    "type": "boolean"
                }
            }
        },
        "nodeSelector": {
            "type": "object",
            "additionalProperties": false
        },
        "podAnnotations": {
            "type": "object",
            "additionalProperties": false
        },
        "podCertificates": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "maxExpirationSeconds": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "maximum": 7862400,
                    "minimum": 3600
                }
            }
        },
        "podLabels": {
            "type": "object",
            "additionalProperties": false
        },
        "podSecurityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "runAsGroup": {
                    "type": "integer",
                    "minimum": 1
                },
                "runAsNonRoot": {
                    "const": true
                },
                "runAsUser": {
                    "type": "integer",
                    "minimum": 1
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "replicaCount": {
            "type": "integer",
            "minimum": 0
        },
        "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "securityContext": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowPrivilegeEscalation": {
                    "const": false
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "privileged": {
                    "const": false
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                },
                "runAsNonRoot": {
                    "const": true
                },
                "runAsUser": {
                    "type": "integer",
                    "minimum": 1
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "annotations": {
                    "type": "object",
                    "additionalProperties": false
                }
            }
        },
        "serviceType": {
            "type": "string"
        },
        "subscriptionID": {
            "type": "string"
        },
        "substrate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "egressGateway": {
                    "type": "string"
                },
                "namespace": {
                    "type": "string"
                },
                "releaseName": {
                    "type": "string"
                },
                "trustDomain": {
                    "type": "string"
                }
            }
        },
        "terminationGracePeriodSeconds": {
            "type": "integer"
        },
        "tolerations": {
            "type": "array"
        }
    }
}
